{
  "name": "product-customization",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "concurrently \"pnpm dev:web\" \"pnpm dev:api\" \"pnpm dev:merchant\"",
    "dev:web": "pnpm --filter web dev --hostname 0.0.0.0",
    "dev:api": "pnpm --filter api dev",
    "dev:merchant": "pnpm --filter merchant-app dev"
  },
  "devDependencies": {
    "concurrently": "^10.0.4"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "canvas"
    ]
  }
}